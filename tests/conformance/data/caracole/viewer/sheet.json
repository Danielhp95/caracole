    "ignorecase": false
   },
   "_STAFF": {
    "pattern": "\\s*(?:[A-Ga-g][#b]?\\s*[|:]|\\|)[\\s\\d|:()\\[\\]<>/\\\\^~*.=+'hpbrstxvPMHBRSTXV-]*",
    "ignorecase": false
   },
   "_SOLFEGE": {
    "pattern": "(?i)(do|re|mi|fa|sol|la|si)(?!dd|ug|lt)",
    "ignorecase": false
   },
   "_LEAD_GAP": {
    "pattern": "^((?:\\[[^\\[\\]]*\\])+) +(?=[^\\[\\s])",
    "ignorecase": false
   },
   "_WORD": {
    "pattern": "[^\\s|]+",
    "ignorecase": false
   },
   "_MARKUP_START": {
    "pattern": "<(?=.*>)",
    "ignorecase": false
   },
   "_DECODED_BACKSLASH": {
    "pattern": "\\\\(?=u[0-9a-fA-F]{4}|$)",
    "ignorecase": false
   },
   "_DIRECTIVE_LIKE": {
    "pattern": "\\s*\\{.*\\}\\s*",
    "ignorecase": false
   }
