    "pattern": "[(\\[]\\s*(?:[xX×]\\s*\\d+|\\d+\\s*[xX×]?)\\s*[)\\]]|(?<!\\w)(?:[xX×]\\d+|\\d+[xX×])(?!\\w)|(?<!\\w)(?i:n\\.?c\\.?)(?!\\w)",
