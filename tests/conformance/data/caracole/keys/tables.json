 "patterns": {
  "_ACOUSTIC_WORD": {
   "ignorecase": true,
   "pattern": "\\b(?:acoustic|ac[uú]stic[oa]|unplugged)\\b"
  },
  "_BRACKETED": {
   "ignorecase": false,
   "pattern": "[(\\[（［【][^)\\]）］】]*[)\\]）］】]"
  },
  "_DASH_SUFFIX": {
   "ignorecase": true,
   "pattern": "\\s+[-–—]\\s+(?:(?:\\d{4}\\s+)?(?:digital\\s+)?remaster(?:ed)?(?:\\s+(?:version|edition|\\d{4}))*|remasterizad[oa](?:\\s+\\d{4})?|(?:live|(?:en|ao)\\s+vivo|en\\s+directo|(?:mtv\\s+)?unplugged|acoustic|(?:en\\s+)?ac[uú]stic[oa]|versi[oó]n\\s+ac[uú]stica)(?:[\\s;,/].*)?|radio\\s+(?:edit|version)|single\\s+(?:edit|version)|album\\s+version|edit|demo(?:\\s+version)?|bonus\\s+track|mono|stereo|(?:\\d{4}\\s+)?(?:stereo|mono)\\s+(?:mix|version)|\\d{4}\\s+mix|recorded\\s+(?:live\\s+)?at\\s.*|[^-–—]*\\bsessions?|from\\s.*\\bsoundtrack\\b.*|from\\s+[\\\"“].*)\\s*$"
  },
  "_FEATURING": {
   "ignorecase": true,
   "pattern": "\\s*[(\\[（［【]\\s*(?:feat\\.|ft\\.|(?:feat|ft|featuring|with)\\s)[^)\\]）］】]*[)\\]）］】]|\\s+(?:feat\\.|ft\\.|featuring\\s).*$"
  },
  "_LIVE_WORD": {
   "ignorecase": true,
   "pattern": "\\b(?:live|vivo|directo)\\b"
  },
  "_MORA": {
   "ignorecase": false,
   "pattern": "(?:[bcdfghjkmnprstvwz]?[hy]?|ts)[aeiou]|n(?![aeiouy])|([bcdfgjkpstz])(?=\\1)|t(?=ch)"
  },
  "_PAREN_FEAT": {
   "ignorecase": true,
   "pattern": "\\s*[\\(\\[](?:feat\\.?|ft\\.?|featuring|with)\\s[^\\)\\]]*[\\)\\]]"
  },
  "_PAREN_SUFFIX": {
   "ignorecase": true,
   "pattern": "\\s*[\\(\\[](?:live(?:\\s+(?:at|from|in|on)\\b[^\\)\\]]*)?|(?:(?:en|ao)\\s+vivo|en\\s+directo)(?:\\s[^\\)\\]]*)?|(?:\\d{4}\\s+)?remaster(?:ed)?(?:\\s+\\d{4})?|remasterizad[oa](?:\\s+\\d{4})?|(?:acoustic|(?:en\\s+)?ac[uú]stic[oa]|versi[oó]n\\s+ac[uú]stica)(?:\\s+version)?|(?:mtv\\s+)?unplugged|radio\\s+(?:edit|version)|single\\s+edit|demo(?:\\s+version)?|\\d{4}\\s+mix|mono|stereo|from\\s[^\\)\\]]*\\bsoundtrack\\b[^\\)\\]]*|from\\s+[\\\"“][^\\)\\]]*)[\\)\\]]"
  },
  "_PART_BREAK": {
   "ignorecase": false,
   "pattern": "\\s+[-–—/|]\\s+|[()\\[\\]{}（）［］｛｝【】「」『』《》〈〉〔〕〖〗／｜]"
  },
  "_RESERVED": {
   "ignorecase": false,
   "pattern": "[*?\"<>|\\x00-\\x1f\\x7f]"
  }
 }
