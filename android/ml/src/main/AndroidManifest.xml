<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ONNX Runtime's AAR declares a content provider, ai.onnxruntime.TelemetryInitializer, that loads the runtime at
         the app's start and hands its native telemetry (Microsoft's 1DS, mobile.events.data.microsoft.com) an HTTP
         client: removed, so the runtime has none ("Android telemetry is unavailable because the 1DS Java HttpClient
         was not initialized"). OrtModels also sets ORT_DISABLE_TELEMETRY before the first environment. The AAR's
         INTERNET and ACCESS_NETWORK_STATE are the app's own already. NoTelemetryTest holds the installed app to it. -->
    <!-- MlChordModels holds a partial wake lock while the models hear a song (the design's §3.4); the app has the
         permission already (WorkManager's), :ml's own test APK hasn't. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- The chord models' process (the design's §3.3): MlService alone runs in ":ml", bound by MlChordModels from
             the main process, so the models' memory, a crash or the low-memory killer never touch the app's server.
             Not exported: only caracole's own processes bind it. :ml is the debug build's alone, so the release's
             manifest has neither (release-check.sh). -->
        <service
            android:name="io.github.danielhp95.caracole.ml.MlService"
            android:exported="false"
            android:process=":ml" />

        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>
</manifest>
