<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build's launcher icon, in place of main's: amber, the logo smaller over a red DEBUG mark, so it is never
     taken for F-Droid's caracole beside it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_debug_background" />
    <foreground android:drawable="@drawable/ic_launcher_debug_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_debug_monochrome" />
</adaptive-icon>
