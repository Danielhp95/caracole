<?xml version="1.0" encoding="utf-8"?>
<!-- The pinch's size label (SizeLabel): a pill in the bar's colours, its edge apart from the page under it (white
     over a light page's accent-coloured heading, the accent on a dark page). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/bar" />
    <stroke android:width="1.5dp" android:color="@color/label_edge" />
    <corners android:radius="999dp" />
</shape>
