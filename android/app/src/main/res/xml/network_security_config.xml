<?xml version="1.0" encoding="utf-8"?>
<!-- caracole serve is plain HTTP, at whatever address the user types (a LAN or tailnet IP, a name):
     a per-domain rule can't name it, so cleartext is allowed for the app. The WebView's own pages
     come from the phone's own caracole, plain HTTP on 127.0.0.1 (Links: that exact origin alone),
     never from the network. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
