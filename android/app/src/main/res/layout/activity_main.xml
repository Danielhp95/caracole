<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- A small top bar: the page's title, the sync button (the page's sync sheet), and a menu with Library and
         Settings. -->
    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/on_bar"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/sync"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sync"
            android:src="@drawable/ic_sync"
            android:tooltipText="@string/sync" />

        <ImageButton
            android:id="@+id/more"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- The unattended sync's line: "Syncing with the computer…", then what it came to or the error, briefly. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- The first start's offer of the site catalogues (SiteCatalogues.firstStart): once, to a phone with no
             computer set and no site's index, shown once the opening screen is gone (OpeningScreen.whenGone): gone
             till then, so neither drawn over the logo (its elevation would put it above) nor live under it. -->
        <LinearLayout
            android:id="@+id/catalogue_offer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:background="@drawable/offer_card"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/offer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/offer_title"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/offer_text"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/offer_not_now"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/offer_not_now" />

                <Button
                    android:id="@+id/offer_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/offer_download" />
            </LinearLayout>
        </LinearLayout>

        <!-- caracole's logo while the app opens, over the page until the WebView draws its first one
             (MainActivity.loaded): no blank screen between Android's own splash and the library. Not clickable, so
             nothing waits on it. -->
        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:contentDescription="@string/loading"
                android:src="@drawable/logo_loading" />

            <!-- A segment a step (OpeningSteps): done ones filled, the current one with a moving shine (OpeningScreen). -->
            <LinearLayout
                android:id="@+id/opening_steps"
                android:layout_width="132dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <FrameLayout style="@style/OpeningSegment" android:layout_marginEnd="4dp">
                    <View style="@style/OpeningShine" />
                </FrameLayout>

                <FrameLayout style="@style/OpeningSegment" android:layout_marginEnd="4dp">
                    <View style="@style/OpeningShine" />
                </FrameLayout>

                <FrameLayout style="@style/OpeningSegment">
                    <View style="@style/OpeningShine" />
                </FrameLayout>
            </LinearLayout>

            <!-- What is happening, said once a step. -->
            <TextView
                android:id="@+id/opening_said"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/opening_open"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <!-- A step slower than OpeningScreen.SLOW_MS: it is still working. -->
            <TextView
                android:id="@+id/opening_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/opening_slow"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- The size a pinch is at ("135%"), near the top of the page while it lasts (SizeLabel); said once at its
             end rather than read here at each step. -->
        <TextView
            android:id="@+id/size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/size_label"
            android:elevation="4dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:minWidth="76dp"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="@color/on_bar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
