<?xml version="1.0" encoding="utf-8"?>
<!-- The test APK's own: OtherProcessRuns, a client of YtDlpService in another process of the app (":other"), so that
     AcrossProcessesTest has two clients in two processes, as the bench's ":ytbench" and the main process are. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="io.github.danielhp95.caracole.youtube.OtherProcessRuns"
            android:exported="false"
            android:process=":other" />
    </application>
</manifest>
