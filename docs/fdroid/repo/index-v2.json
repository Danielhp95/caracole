{"repo": {"name": {"en-US": "Caracole"}, "description": {"en-US": "Multi-site and multi-instrument tablature indexer with support for offline reads, songbook exporting and many other features."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "f00213a73194f671f939284f0a32afebb8f9727be1a72976b5d4195005890f4a", "size": 408129}}, "address": "https://danielhp95.github.io/caracole/fdroid/repo", "timestamp": 1795532549000, "categories": {"Multimedia": {"name": {"en-US": "Multimedia"}}, "Reading": {"name": {"en-US": "Reading"}}}}, "packages": {"io.github.danielhp95.caracole": {"metadata": {"added": 1795452413000, "categories": ["Multimedia", "Reading"], "issueTracker": "https://github.com/Danielhp95/caracole/issues", "lastUpdated": 1795457986000, "license": "MIT", "sourceCode": "https://github.com/Danielhp95/caracole", "webSite": "https://github.com/Danielhp95/caracole", "screenshots": {"phone": {"en-US": [{"name": "/io.github.danielhp95.caracole/en-US/phoneScreenshots/phone-chord.png", "sha256": "026be059f836c62e8169cb5dd112d13d832956b240ec8629961d2438bc6b4230", "size": 135847}, {"name": "/io.github.danielhp95.caracole/en-US/phoneScreenshots/phone-pinyin.png", "sha256": "86f66862f28d1640b3102f78e6c73d65331e7a47f58def87b5785072fd1ff2e3", "size": 119925}]}}, "authorName": "Daniel Hernandez", "name": {"en-US": "caracole"}, "summary": {"en-US": "Your caracole library of chord sheets, offline on the phone"}, "description": {"en-US": "caracole keeps a copy of your caracole library on the phone and runs caracole\nthere, so it works with the computer off.\n\n* Your library, offline: the library page, every sheet with all its tools\n  (key, capo, chord diagrams, harmony, pinyin, strum), kept versions,\n  harmonica tabs and songbooks.\n* Search and fetch from the phone: the computer's site indexes come with a\n  sync, so the phone's search finds songs on the sites offline.\n* Sync with your computer: the two libraries each take what the other\n  changed; where both changed a song, you pick which to keep.\n* Guitar Pro on the phone: a file drawn as score and tab and played.\n* Share to caracole: share a song from a music app to find it or fetch it.\n\nIt needs a computer running caracole serve to sync from:\nhttps://github.com/Danielhp95/caracole"}, "icon": {"en-US": {"name": "/io.github.danielhp95.caracole/en-US/icon_0KLk2aqwcpzCtpoHV29FKQcTfUpVMTJnSIwghCtGem4=.png", "sha256": "d0a2e4d9aab0729cc2b69a07576f452907137d4a55313267488c20842b467a6e", "size": 429179}}, "preferredSigner": "332c457ddadd0c7a2f2b7d880c827fec23cd2ab143f21a2f38c759d47b48a8f1"}, "versions": {"885978a3044f00b947d389b6c5f648a9506b7551bdcfe92d269f41bd2b9d1ac0": {"added": 1795457986000, "file": {"name": "/io.github.danielhp95.caracole_2.apk", "sha256": "885978a3044f00b947d389b6c5f648a9506b7551bdcfe92d269f41bd2b9d1ac0", "size": 7201340}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "0.2.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["332c457ddadd0c7a2f2b7d880c827fec23cd2ab143f21a2f38c759d47b48a8f1"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "io.github.danielhp95.caracole.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "d842903d641895159d938bbc1736f24c3b27fbb4399b44f9dbb08434442e6ae9": {"added": 1795452413000, "file": {"name": "/io.github.danielhp95.caracole_1.apk", "sha256": "d842903d641895159d938bbc1736f24c3b27fbb4399b44f9dbb08434442e6ae9", "size": 7196296}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["332c457ddadd0c7a2f2b7d880c827