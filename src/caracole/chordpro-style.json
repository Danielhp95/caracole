{
  "pdf": {
    "theme": {
      "foreground-light": "#efece6",
      "foreground-medium": "#8a847a"
    },
    "margintop": 92,
    "marginbottom": 40,
    "marginleft": 48,
    "marginright": 40,
    "headspace": 64,
    "footspace": 20,
    "spacing": {
      "title": 1.15,
      "lyrics": 1.15,
      "chords": 1.0,
      "empty": 0.6,
      "tab": 1.0
    },
    "diagrams": {
      "show": "top",
      "width": 7,
      "height": 7,
      "vcells": 4,
      "linewidth": 0.1,
      "hspace": 3.2,
      "vspace": 2.2,
      "dotsize": 0.8,
      "fingers": true
    },
    "formats": {
      "title": {
        "title": ["%{title}", "", ""],
        "subtitle": ["%{subtitle}", "", ""],
        "footer": ["", "", "%{page}"]
      },
      "default": {
        "footer": ["%{title}", "", "%{page}"]
      }
    },
    "fonts": {
      "title": { "name": "Helvetica-Bold", "size": 24 },
      "subtitle": { "name": "Helvetica", "size": 11, "color": "#645f57" },
      "text": { "name": "Helvetica", "size": 11 },
      "chord": { "name": "Helvetica-Bold", "size": 10.5, "color": "#b4441e" },
      "annotation": { "name": "Helvetica-Oblique", "size": 9.5, "color": "#8a847a" },
      "comment": { "name": "Helvetica-Bold", "size": 9, "color": "#b4441e" },
      "tab": { "name": "Courier", "size": 10 },
      "footer": { "name": "Helvetica", "size": 8, "color": "#8a847a" },
      "diagram": { "name": "Helvetica-Bold", "size": 9 },
      "diagram_base": { "name": "Helvetica", "size": 6 }
    }
  }
}
